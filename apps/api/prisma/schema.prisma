generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────────────

enum Category {
  Food
  Rent
  Groceries
  Transport
  Shopping
  Subscriptions
  Utilities
  Health
  Entertainment
  Income
  Transfer
  Other
}

enum CategoryRuleSource {
  ai
  user
}

enum FileType {
  CSV
  XLSX
  XLS
}

/// Lifecycle of an in-progress import session (ST-002→ST-007).
enum UploadSessionStatus {
  uploaded          // file received, awaiting column mapping
  mapped            // column mapping saved
  parsed            // rows normalized, malformed flagged
  malformed_review  // user reviewing/excluding malformed rows
  committed         // import committed; session pending deletion
  failed
}

/// Status of a Cashfree payment order.
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}


// ── User (ST-001) ───────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions   Transaction[]
  imports        Import[]
  categoryRules  CategoryRule[]
  columnMappings ColumnMapping[]
  uploadSessions UploadSession[]
  payments       Payment[]
}

// ── Import (ST-007) ─────────────────────────────────────────────────

model Import {
  id           String    @id @default(uuid())
  userId       String
  filename     String
  bankName     String?
  periodStart  DateTime?
  periodEnd    DateTime?
  rowsTotal    Int       @default(0)
  rowsImported Int       @default(0)
  rowsDuplicate Int      @default(0)
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@index([userId])
  @@index([userId, createdAt])
}

// ── Transaction (ST-004, ST-006, ST-008, ST-012, ST-013) ────────────
//
// amount is signed: debit = negative, credit = positive (ST-004 AC-2/3/4).
// dedupHash = SHA-256(userId|txnDate|amount|normalizedDescription) (D-3).
// isMalformed flags best-effort rows the user chose to include (ST-005 note).
// isRecurring is reserved for P2 (ST-011 notes); always false in MVP.

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  importId    String
  txnDate     DateTime
  description String
  merchant    String?
  amount      Decimal  @db.Decimal(12, 2)
  balance     Decimal? @db.Decimal(12, 2)
  category    Category @default(Other)
  isRecurring Boolean  @default(false)
  isMalformed Boolean  @default(false)
  dedupHash   String
  note        String?  @db.Text
  createdAt   DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  import Import @relation(fields: [importId], references: [id])

  @@index([userId, dedupHash])
  @@index([userId, txnDate])
  @@index([userId, importId])
  @@index([userId, category, txnDate])
  @@index([userId, merchant])
  @@index([importId])
}

// ── CategoryRule (ST-008, ST-013 feedback loop) ─────────────────────
//
// Unique per (userId, merchantPattern): ST-008 rule-conflict resolution
// ("most recent wins") updates the existing row's `updatedAt`.

model CategoryRule {
  id            String            @id @default(uuid())
  userId        String
  merchantPattern String
  category      Category
  source        CategoryRuleSource
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user          User              @relation(fields: [userId], references: [id])

  @@unique([userId, merchantPattern])
  @@index([userId, merchantPattern])
}

// ── ColumnMapping / BankPreset (ST-003) ─────────────────────────────
//
// mapping is the serialized ColumnMappingSchema (date, description,
// debit?, credit?, balance?, ref?). Unique per (userId, bankName) so a
// re-save updates the preset rather than inserting a duplicate.

model ColumnMapping {
  id        String   @id @default(uuid())
  userId    String
  bankName  String
  mapping   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, bankName])
  @@index([userId])
}

// ── UploadSession (ST-002→ST-007 pipeline state) ────────────────────
//
// Stores intermediate import state so the user can navigate back across
// the upload→map→parse→review→commit steps without re-uploading.
// Deleted after a successful commit (ST-002 D-2). JSON columns hold arrays
// serialized to/from the shared upload schemas.

model UploadSession {
  id             String             @id @default(uuid())
  userId         String
  filename       String
  fileType       FileType
  bankName       String?
  headers        Json               // string[]
  rawRows        Json               // Array<{ [header: string]: string }>
  normalizedRows   Json             // Array<NormalizedRow>
  malformedRows   Json              // Array<{ rowIndex, rawData, reasons[], excluded }>
  mapping        Json?              // ColumnMapping | null
  status         UploadSessionStatus @default(uploaded)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user           User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, status])
}

// ── Payment (Cashfree integration) ──────────────────────────────────────────
//
// Tracks each payment order created via Cashfree. One row per order attempt.
// cashfreeOrderId is the ID returned by Cashfree PGCreateOrder.
// paymentSessionId is used by the frontend Cashfree JS SDK to open checkout.

model Payment {
  id                String        @id @default(uuid())
  userId            String
  cashfreeOrderId   String        @unique
  paymentSessionId  String
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  plan              String        // e.g. "pro_monthly" | "pro_annual"
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, status])
  @@index([cashfreeOrderId])
}

