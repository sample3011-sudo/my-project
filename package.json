{
  "name": "sample-crm",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint:fix": "pnpm -r lint:fix",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "vercel-build": "pnpm -F @repo/shared build && pnpm -F api prisma:generate && pnpm -F api build && pnpm -F ui build"
  }
}
